# dependencies
node_modules/

# local env (never commit real environment files)
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test

# allow safe template
!.env.example

# build
dist/
build/
.next/
.expo/
coverage/
.turbo/
*.tsbuildinfo

# Expo generated native projects (continuous native generation)
apps/mobile/ios/
apps/mobile/android/

# Expo (apps/mobile) generated / local tooling
apps/mobile/expo-env.d.ts
apps/mobile/.kotlin/
apps/mobile/.metro-health-check*
apps/mobile/**/*.orig.*

# Next.js (apps/admin) generated
apps/admin/next-env.d.ts
apps/admin/out/

# system
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# terraform
*.tfstate
*.tfstate.*
.terraform/
# .terraform.lock.hcl is intentionally committed (HashiCorp guidance)

# certificates / keys
*.pem
*.key
*.p12
*.pfx
*.jks
*.p8
*.mobileprovision

# Claude local settings (personal overrides)
.claude/settings.local.json

# test output
test-results/
playwright-report/

# logs
*.log
