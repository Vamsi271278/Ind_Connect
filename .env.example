# Project Connect — local development configuration template.
#
# Safe template only: no real credentials, ever. Copy the relevant section to an
# app-local, git-ignored file:
#   apps/api/.env           (API)
#   apps/admin/.env.local   (Admin)
#   apps/mobile/.env.local  (Mobile)
# Values below match the local compose stack (compose.yaml).

# ---------------------------------------------------------------- API
NODE_ENV=development
PORT=3000
# Proxy hops whose X-Forwarded-For is trusted (0 locally; set per environment).
TRUST_PROXY=0
DATABASE_URL=postgresql://project_connect:local_project_connect_password@localhost:5432/project_connect
REDIS_URL=redis://localhost:6379

# OTP: the fake provider is the only one until Twilio is approved; it refuses
# to start in production. Policy values below are the approved defaults.
OTP_PROVIDER=fake
OTP_FAKE_CODE=000000
# OTP_CODE_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_SENDS_PER_PHONE_PER_HOUR=5
# OTP_SENDS_PER_PHONE_PER_DAY=10
# OTP_SENDS_PER_IP_PER_HOUR=20
# OTP_SENDS_PER_DEVICE_PER_HOUR=10
# OTP_VERIFIES_PER_IP_PER_HOUR=30

# Keys the HMAC for log-safe phone/IP identifiers. Local: any random string of
# 32+ characters. Non-local: Secrets Manager.
PHONE_HASH_PEPPER=
# "*" or comma-separated ISO 3166-1 alpha-2 codes. Production policy is decided
# with the Twilio / Fraud Guard review.
PHONE_ALLOWED_COUNTRIES=*

ACCESS_TOKEN_ISSUER=project-connect-local
ACCESS_TOKEN_AUDIENCE=project-connect-mobile
# Generate locally with: pnpm --filter @project-connect/api keys:generate
ACCESS_TOKEN_PRIVATE_KEY=
ACCESS_TOKEN_KEY_ID=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_ROLLING_DAYS=30
# SESSION_FAMILY_MAX_DAYS=90
# REFRESH_GRACE_SECONDS=30

# Public app bootstrap (ADR-076). Feature flags come from config until the
# ADR-032 flag store exists: a JSON object of snake_case names to booleans.
# MAINTENANCE_MODE=false
# MOBILE_MINIMUM_SUPPORTED_VERSION=0.0.0
# FEATURE_FLAGS={}

# ---------------------------------------------------------------- Admin
# Server-side only (not exposed to the browser).
API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------- Mobile
# EXPO_PUBLIC_* values are bundled into the app and are public. Never put secrets here.
# Android emulator: http://10.0.2.2:3000   Physical device: http://<your-LAN-IP>:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Public Terms of Service / Privacy Policy URLs shown on Welcome. Leave empty until legal publishes them.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
