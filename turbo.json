{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#lint:root": {
      "inputs": [
        "*.{js,mjs,cjs,ts}",
        "scripts/**",
        "tsconfig.json",
        "tsconfig.base.json",
        "package.json"
      ]
    },
    "//#typecheck:root": {
      "inputs": [
        "*.{js,mjs,cjs,ts}",
        "scripts/**",
        "tsconfig.json",
        "tsconfig.base.json",
        "package.json"
      ]
    }
  }
}
